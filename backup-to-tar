#!/bin/bash

ADDITIONAL_TAR_ARGS_DIRECTIVE="TAR_ARGS="
EXCLUDE_DIRECTIVE="EXCLUDE:"
DEFAULT_BACKUP_DEST_DIR="$HOME/system_backups" # CHANGED: Default to a persistent location

gecho() {
    echo -e "\033[1;32m$1\033[0m"
}
recho() {
    echo -e "\033[1;31m$1\033[0m"
}
yecho() {
    echo -e "\033[1;33m$1\033[0m"
}

help() {
    echo "Backup the directories and files listed in a configuration file using an incremental strategy."
    echo "A full backup is created initially, followed by smaller incremental backups."
    echo "Each run produces a single .tar.gz archive to be uploaded manually."
    echo "Caches are excluded from the backup. Version control directories such as '.git' are NOT"
    echo "excluded automatically - use the config directives below if you want them left out."
    echo
    echo "Input file format (e.g., ~/.backup.conf):"
    echo "- List absolute paths of directories and files to backup, one per line."
    echo "- Lines beginning with '#' are comments."
    echo "- Additional tar args can be added with: '$ADDITIONAL_TAR_ARGS_DIRECTIVE --exclude=\"*.foo\" --exclude=\"*.bar\"'"
    echo "- Paths can be subtracted from the backup with: '$EXCLUDE_DIRECTIVE /path/to/skip'"
    echo "  An excluded directory (and everything under it) is left out, while its siblings"
    echo "  remain included, e.g. with '~/foo/bar' included and '$EXCLUDE_DIRECTIVE ~/foo/bar/baz',"
    echo "  ~/foo/bar/baz is skipped but ~/foo/bar/bat is still backed up."
    echo "- A leading '~/' is expanded to \$HOME in both included and excluded paths."
    echo "- Exclude paths may contain wildcards, e.g. '$EXCLUDE_DIRECTIVE ~/code/**/node_modules'."
    echo "  Note that tar's '*' spans '/', so a single '*' already matches any depth;"
    echo "  '/**/' additionally matches zero directories (like a shell globstar)."
    echo "- '$EXCLUDE_DIRECTIVE' lines are anchored, so a bare name matches nothing. To drop a name at"
    echo "  any depth, use '$ADDITIONAL_TAR_ARGS_DIRECTIVE --exclude=\".git\"' (or '$EXCLUDE_DIRECTIVE ~/code/**/.git' for one tree)."
    echo
    echo "Options:"
    echo "    -h    Display this help message."
    echo "    -i    Optional input configuration file (default: ~/.backup.conf)."
    echo "    -o    Optional output directory for archives and snapshot file (default: $DEFAULT_BACKUP_DEST_DIR)."
    echo "    -n    Dry run: list every file that the config selects, then exit. Writes no archive,"
    echo "          creates no output directory and leaves the snapshot file untouched. Note that"
    echo "          this lists the full candidate set, not just the files an incremental run would"
    echo "          actually store."
    echo
    echo "IMPORTANT: The output directory must be persistent for incremental backups to work across runs."
}

# --- Argument Parsing (from your script) ---
BACKUP_CONF="$HOME/.backup.conf"
BACKUP_DEST_DIR="$DEFAULT_BACKUP_DEST_DIR"
DRY_RUN=0 # 0 for a real backup, 1 to only list what would be archived

while getopts "hi:o:n" arg; do
    case $arg in
        h) # display Help
            help
            exit 0
            ;;
        i) # optional config file
            BACKUP_CONF=$OPTARG
            ;;
        o) # optional specify output directory
            BACKUP_DEST_DIR=$OPTARG
            ;;
        n) # dry run: list what would be archived, change nothing
            DRY_RUN=1
            ;;
        \?) # Invalid arg
            echo "Error: Invalid argument" >&2
            help
            exit 1
            ;;
    esac
done

# --- Validations ---
if [ ! -f "$BACKUP_CONF" ]; then
    echo "Error: Backup configuration file not found: $BACKUP_CONF" >&2
    exit 1
fi

# A dry run writes nothing, so it must not create the destination directory either.
if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$BACKUP_DEST_DIR"
    if [ ! -d "$BACKUP_DEST_DIR" ] || [ ! -w "$BACKUP_DEST_DIR" ]; then
        echo "Error: Backup destination directory is not accessible or writable: $BACKUP_DEST_DIR" >&2
        exit 1
    fi
fi

# --- File Definitions ---
SNAPSHOT_FILE="$BACKUP_DEST_DIR/backup_snapshot.snar"
TMP_SOURCES_LIST=$(mktemp) # Temporary file for tar --files-from
TMP_EXCLUDES_LIST=$(mktemp) # Temporary file for tar --exclude-from
DATE=$(date +%Y-%m-%d_%H%M%S) # More precise timestamp for archive names

cleanup_tmp_files() {
    rm -f "$TMP_SOURCES_LIST" "$TMP_EXCLUDES_LIST"
}
trap cleanup_tmp_files EXIT

# Expand a leading '~/' (or a bare '~') to $HOME, and strip trailing slashes
normalise_path() {
    local p="$1"
    case "$p" in
        "~") p="$HOME" ;;
        "~/"*) p="$HOME/${p#\~/}" ;;
    esac
    # Strip trailing slashes so tar's exclude patterns match directory members
    while [[ "$p" == */ && "$p" != "/" ]]; do
        p="${p%/}"
    done
    printf '%s' "$p"
}

# Emit every variant of an exclude pattern in which each '/**/' either stays put or
# collapses to '/'. tar's '*' already spans '/', so '/code/**/nm' matches any nested
# 'nm'; the collapsed variant '/code/nm' is what makes '**' also match zero
# directories, the way a shell globstar would. Prints one pattern per line.
expand_globstar() {
    local prefix="$1" p="$2" head rest
    if [[ "$p" == */'**'/* ]]; then
        head="${p%%/'**'/*}"
        rest="${p#*/'**'/}"
        expand_globstar "$prefix$head/**/" "$rest"
        expand_globstar "$prefix$head/" "$rest"
    else
        printf '%s\n' "$prefix$p"
    fi
}

# --- Process Configuration File ---
echo "Processing configuration file: $BACKUP_CONF"
ADDITIONAL_TAR_ARGS_FROM_CONF=""
found_directive=0

while IFS= read -r line || [[ -n "$line" ]]; do
    # Trim leading/trailing whitespace (optional, but good practice)
    path=$(echo "$line" | awk '{$1=$1};1')

    if [[ -z "$path" ]] || [[ "$path" =~ ^# ]]; then # Skip empty lines and comments
        continue
    fi

    if [[ "$path" =~ ^${ADDITIONAL_TAR_ARGS_DIRECTIVE} ]]; then
        if [ $found_directive -eq 0 ]; then
            ADDITIONAL_TAR_ARGS_FROM_CONF=$(echo "$path" | sed "s#^${ADDITIONAL_TAR_ARGS_DIRECTIVE}##")
            echo "Found additional tar arguments in config: $ADDITIONAL_TAR_ARGS_FROM_CONF"
            found_directive=1
        else
            yecho "Warning: Multiple '$ADDITIONAL_TAR_ARGS_DIRECTIVE' lines found. Using the first one." >&2
        fi
        continue # Directive line is not a path to backup
    fi

    if [[ "$path" =~ ^${EXCLUDE_DIRECTIVE} ]]; then
        exclude_path=$(echo "${path#$EXCLUDE_DIRECTIVE}" | awk '{$1=$1};1')
        exclude_path=$(normalise_path "$exclude_path")
        if [[ -z "$exclude_path" ]]; then
            yecho "Warning: Ignoring '$EXCLUDE_DIRECTIVE' line with no path." >&2
        elif [[ "$exclude_path" != */* ]]; then
            # Anchored patterns are matched against absolute member names, so a bare
            # name can never match. Point at the directive that does what they meant.
            yecho "Warning: '$EXCLUDE_DIRECTIVE $exclude_path' is a bare name and will match nothing." >&2
            yecho "         Use '$ADDITIONAL_TAR_ARGS_DIRECTIVE --exclude=\"$exclude_path\"' to exclude it at any depth." >&2
        elif [[ "$exclude_path" == *[\*\?\[]* ]]; then
            # A wildcard pattern: no existence check, and expand any '/**/' segments
            expand_globstar "" "$exclude_path" >> "$TMP_EXCLUDES_LIST"
            echo "Excluding (pattern): $exclude_path"
        else
            if [ ! -e "$exclude_path" ]; then
                yecho "Warning: Excluded path does not currently exist: '$exclude_path'" >&2
            fi
            echo "$exclude_path" >> "$TMP_EXCLUDES_LIST"
            echo "Excluding: $exclude_path"
        fi
        continue # Directive line is not a path to backup
    fi

    path=$(normalise_path "$path")

    # Check if path exists before adding to list
    if [ -e "$path" ]; then
        echo "$path" >> "$TMP_SOURCES_LIST"
    else
        yecho "Warning: Path specified in $BACKUP_CONF not found, skipping: '$path'" >&2
    fi
done < "$BACKUP_CONF"

if [ ! -s "$TMP_SOURCES_LIST" ]; then
    echo "Error: No valid source files or directories found to back up. Check $BACKUP_CONF." >&2
    exit 1
fi

# --- Prepare Tar Arguments ---
# Start with an array for safety, though eval will be used for the final string
# Standard excludes. Version control directories are deliberately NOT excluded here -
# that is left to the config's EXCLUDE:/TAR_ARGS= directives.
TAR_CMD_ARGS_STR="--exclude-backups --exclude-caches-all --exclude='.venv' --exclude='__pycache__'"

# Append args from config file
if [[ -n "$ADDITIONAL_TAR_ARGS_FROM_CONF" ]]; then
    TAR_CMD_ARGS_STR="$TAR_CMD_ARGS_STR $ADDITIONAL_TAR_ARGS_FROM_CONF"
fi

# Append the EXCLUDE: paths from the config. '--anchored' makes each pattern match
# from the start of the (absolute) stored member name, so excluding
# /home/me/foo/bar/baz leaves /home/me/foo/bar/bat alone. It comes last so it only
# applies to these patterns and not to the component excludes above ('.venv' etc) or
# to any --exclude= given via TAR_ARGS=, which must keep matching at any depth.
if [ -s "$TMP_EXCLUDES_LIST" ]; then
    TAR_CMD_ARGS_STR="$TAR_CMD_ARGS_STR --anchored --exclude-from=\"$TMP_EXCLUDES_LIST\""
fi

echo "Final combined tar arguments: $TAR_CMD_ARGS_STR"

# --- Dry Run ---
# Walk the sources applying exactly the same excludes, but throw the archive away.
# No --listed-incremental (so the snapshot is neither read nor written) and no --gzip
# (nothing is stored, so compressing would only burn CPU).
if [ "$DRY_RUN" -eq 1 ]; then
    yecho "DRY RUN: listing the files that would be archived. Nothing will be written."
    if [ -f "$SNAPSHOT_FILE" ]; then
        echo "(A real run would be INCREMENTAL, and would store only what changed since the last backup.)"
    else
        echo "(A real run would be a FULL backup of everything listed below.)"
    fi
    echo
    eval "tar --create \
        $TAR_CMD_ARGS_STR \
        --file=/dev/null \
        --verbose \
        --files-from=\"$TMP_SOURCES_LIST\" \
        --absolute-names"
    TAR_EXIT_CODE=$?
    echo
    if [ $TAR_EXIT_CODE -eq 0 ] || [ $TAR_EXIT_CODE -eq 1 ]; then
        gecho "DRY RUN complete (tar exit code: $TAR_EXIT_CODE). No archive, snapshot or output directory was created."
        exit 0
    fi
    recho "DRY RUN failed (tar exit code: $TAR_EXIT_CODE). The config above would not back up cleanly." >&2
    exit 1
fi

# --- Determine Archive Name and Type ---
ARCHIVE_BASENAME="backup_${DATE}"
if [ ! -f "$SNAPSHOT_FILE" ]; then
    ARCHIVE_BASENAME="${ARCHIVE_BASENAME}_FULL"
    echo "Snapshot file not found. Creating a new FULL backup."
else
    ARCHIVE_BASENAME="${ARCHIVE_BASENAME}_INCR"
    echo "Snapshot file found. Creating an INCREMENTAL backup."
    
    # Create a backup of the snapshot file in case there are errors during tar
    SNAPSHOT_BACKUP_FILE="${SNAPSHOT_FILE}.backup.$$"
    cp "$SNAPSHOT_FILE" "$SNAPSHOT_BACKUP_FILE"
fi
FULL_ARCHIVE_PATH="$BACKUP_DEST_DIR/${ARCHIVE_BASENAME}.tar.gz"

# --- Create the Backup ---
echo "Starting backup..."
echo "  Archive will be: $FULL_ARCHIVE_PATH"
echo "  Snapshot file:   $SNAPSHOT_FILE"
echo "  Sources list:    $TMP_SOURCES_LIST"

# Using eval to correctly interpret the TAR_CMD_ARGS_STR, similar to your original script.
# Ensure paths with spaces are handled by quoting file variables.
eval "tar --create \
    $TAR_CMD_ARGS_STR \
    --file=\"$FULL_ARCHIVE_PATH\" \
    --listed-incremental=\"$SNAPSHOT_FILE\" \
    --files-from=\"$TMP_SOURCES_LIST\" \
    --gzip \
    --absolute-names" # Assumes paths in config are absolute and should be stored as such

TAR_EXIT_CODE=$?

# --- Cleanup and Report ---
cleanup_tmp_files

# Function to cleanup snapshot backup
cleanup_snapshot_backup() {
    if [ -n "$SNAPSHOT_BACKUP_FILE" ] && [ -f "$SNAPSHOT_BACKUP_FILE" ]; then
        rm "$SNAPSHOT_BACKUP_FILE"
    fi
}

# Function to restore snapshot from backup
restore_snapshot_backup() {
    if [ -n "$SNAPSHOT_BACKUP_FILE" ] && [ -f "$SNAPSHOT_BACKUP_FILE" ]; then
        mv "$SNAPSHOT_BACKUP_FILE" "$SNAPSHOT_FILE"
    fi
}

if [ $TAR_EXIT_CODE -eq 0 ] || [ $TAR_EXIT_CODE -eq 1 ]; then # 0=success, 1=files changed during archive
    if [ -s "$FULL_ARCHIVE_PATH" ]; then # Check if archive was created and is not empty
        cleanup_snapshot_backup
        gecho "-------------------------------------------------------------"
        gecho "Backup SUCCEEDED (tar exit code: $TAR_EXIT_CODE)."
        gecho "Archive created: $FULL_ARCHIVE_PATH"
        gecho "Remember to UPLOAD THIS FILE to where you store backups."
        gecho "-------------------------------------------------------------"
        if [ $TAR_EXIT_CODE -eq 1 ]; then
            yecho "Warning: Some files may have changed during archiving." >&2
        fi
    elif [ $TAR_EXIT_CODE -eq 0 ]; then # tar succeeded but archive is empty (or very small)
        cleanup_snapshot_backup
        gecho "-------------------------------------------------------------"
        gecho "Backup SUCCEEDED (tar exit code: $TAR_EXIT_CODE)."
        gecho "Archive created: $FULL_ARCHIVE_PATH"
        gecho "(Archive might be empty or very small if no files changed since last backup)."
        gecho "Remember to UPLOAD THIS FILE to where you store backups."
        gecho "-------------------------------------------------------------"
    else # Should not happen if TAR_EXIT_CODE is 0 or 1
        restore_snapshot_backup
        recho "Error: Backup succeeded (code $TAR_EXIT_CODE) but archive is empty/missing: $FULL_ARCHIVE_PATH" >&2
        exit 1
    fi
else
    restore_snapshot_backup
    recho "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    recho "Backup FAILED (tar exit code: $TAR_EXIT_CODE)."
    recho "Archive may not have been created or is incomplete: $FULL_ARCHIVE_PATH"
    recho "Snapshot file has been restored to its previous state."
    recho "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    # Attempt to clean up potentially incomplete archive
    [ -f "$FULL_ARCHIVE_PATH" ] && rm "$FULL_ARCHIVE_PATH"
    exit 1
fi

exit 0